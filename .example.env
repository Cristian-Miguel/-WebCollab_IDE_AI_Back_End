#.example.env
# Valores de NODE_ENV: development, test, production
NODE_ENV=development
PORT=3000

#Seguridad
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=30d
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_ENCODE_DATA_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:5173

#Base de Datos (Prisma/PostgreSQL como ejemplo)
#Reemplazar con la URL de conexión de su base de datos.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

#Caché y Estado en Tiempo Real (Redis - HU-06-08, HU-12-14, HU-25, HU-26)
REDIS_URL="redis://localhost:6379"
REDIS_PRESENCE_TTL=3600

#Asistencia mediante Inteligencia Artificial (HU-16 - Nunca exponer en Frontend ni Logs)
OPENAI_API_KEY=replace-with-your-openai-or-ollama-api-key
AI_API_URL=http://localhost:11434/api/generate
AI_MODEL=codellama

#Configuración de Correo Electrónico (Nodemailer)
EMAIL_HOST=https://www.google.com/search?q=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="Tu Aplicación noreply@example.com"

#Configuración de Logs (Winston/Pino)
LOG_LEVEL=info
